# Client-side values. Only these two are safe to expose in the bundle.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# --- Server-side only. Never prefix these with VITE_. ---
# Used by scripts/deploy-supabase.mjs, not by the app.
# SUPABASE_ACCESS_TOKEN=sbp_...
# SUPABASE_PROJECT_REF=yhgkrbnmhgspgckvvfhe
# GROQ_API_KEY=gsk_...
# OPENROUTER_API_KEY=sk-or-v1-...   (verification, and the chat fallback)
# CLOUDFLARE_API_TOKEN=cfut_...        (optional third AI provider)
# CLOUDFLARE_ACCOUNT_ID=...            (required alongside the token)
# PURGE_SECRET=any-long-random-string
