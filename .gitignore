node_modules
dist
.env
.env.local
.env.deploy
*.log
.DS_Store

# The Android project is committed so it can be opened in Android Studio and
# uploaded to Play Console directly from a clone. iOS is not generated.
ios/
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/.idea/
android/captures/
android/app/release/
# Where `npm run android:bundle` leaves the Play Store artifact: a build output,
# several megabytes, and rebuilt from source every time.
release/
*.keystore
*.jks

# Generated by `npm run bundle:functions` for hand-deploying to the dashboard.
supabase/manual/
supaUpdate/

# Scratch state written by the Supabase CLI (version cache, link details).
supabase/.temp/

# Kept out of the repository by choice. These files still have to exist locally:
# scripts/deploy-supabase.mjs applies them, and scripts/bundle-functions.mjs
# generates supabase/manual/ and supaUpdate/ from them. A fresh clone will not
# be able to provision a database without them.
supabase/migrations/
# The deployed schema, captured for reference. Same reasoning as the migrations
# above: kept locally so the structure is knowable, out of a public repository.
supabase/CURRENT_SCHEMA.md

# Playwright
test-results/
playwright-report/
.playwright/

# Downloaded archive, not source.
nutripilot.zip

# Signing keystores. A leaked upload key lets anyone ship as you.
nutripilots
*.jks
*.keystore
keystore.properties
