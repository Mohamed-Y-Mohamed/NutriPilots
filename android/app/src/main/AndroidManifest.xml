<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!--
      Backup is off on purpose. The WebView holds a live Supabase session and a
      food diary, which is health data. Auto Backup would copy both into the
      user's Google Drive, and device-to-device transfer would carry the session
      onto a second phone. Neither is worth the convenience.
    -->
    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Meal photos are taken with the camera. -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!--
      Choosing an existing photo goes through the Android photo picker
      (androidx PickVisualMedia), which hands back one image the user selected
      and needs no permission at all. Google Play requires apps with a one-time
      or infrequent need — one meal photo at a time — to use the picker rather
      than request broad gallery access, so these are removed from the merged
      manifest. Capacitor's camera plugin declares them for apps that call
      chooseFromGallery or pickImages; NutriPilot calls neither.
    -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" tools:node="remove" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" tools:node="remove" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" tools:node="remove" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" tools:node="remove" />

    <!-- A device without a camera can still choose a photo from the gallery. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
</manifest>
