# Copy to android/keystore.properties and fill in. That file is gitignored:
# the upload key is the one secret that cannot be rotated by reissuing it —
# whoever holds it can publish as you, and Play will accept it.
#
# With this file present, `npm run android:bundle` produces a signed .aab ready
# for Play Console. Without it the build still succeeds and produces an unsigned
# one, which is what CI gets.
#
# storeFile is resolved relative to the android/ directory. Keep the keystore
# itself outside the repository.
storeFile=../../nutripilot-upload.jks
storePassword=
keyAlias=upload
keyPassword=
